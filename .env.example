
# LLM (free: https://console.groq.com/keys)
GROQ_API_KEY=
GEMINI_API_KEY=

# Image providers (all optional, free keys; blank ones are skipped)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
BRAVE_API_KEY=

# Optional proxy for DuckDuckGo (e.g. http://user:pass@host:port or socks5://host:1080)
DDG_PROXY=

# Name used in Unsplash attribution links (utm_source); use your registered app name
UNSPLASH_APP_NAME=

#supabase keys
SUPABASE_URL=
SUPABASE_ANON_API_KEY=
SUPABASE_STORAGE_BUCKET=


# Clients must send this in the X-API-Key header (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
RADIANT_GLOW_API_KEY=

# Set to true to expose /docs and /openapi.json (they are disabled by default)
RADIANTGLOW_API_DOCS_ENABLED=

# Admin key for POST /api/admin/rotate-key (send as X-Admin-Key); must differ from RADIANT_GLOW_API_KEY
RADIANT_GLOW_ADMIN_KEY=
